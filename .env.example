# Copy to .env and fill in real values. .env is gitignored; this file is not — it documents
# the shape, never the values (SRS 5.3: credentials are never a literal, never a default, never
# a comment, never a fixture — that includes this file).

FACTUS_SANDBOX_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_SANDBOX_USERNAME=
FACTUS_SANDBOX_PASSWORD=
FACTUS_SANDBOX_CLIENT_ID=
FACTUS_SANDBOX_CLIENT_SECRET=

# T-309 fail-closed guard. Absent by default: the service must refuse to start against the
# Factus PRODUCTION URL unless this is explicitly set, and the production secret below must live
# under a name distinct from the sandbox ones above so the two can never be confused.
# FACTUS_ENABLE_PRODUCTION=true
# FACTUS_PRODUCTION_BASE_URL=
# FACTUS_PRODUCTION_CLIENT_ID=
# FACTUS_PRODUCTION_CLIENT_SECRET=
