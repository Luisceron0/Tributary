<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tributary</groupId>
    <artifactId>tributary</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tributary-persistence</artifactId>
  <name>Tributary :: Persistence</name>
  <description>Repositories, Flyway migrations and chain triggers.</description>

  <properties>
    <!-- SRS 5.3: versions are pinned, never ranges. -->
    <!-- T-704/SCA (trivy): 42.7.7 carries CVE-2026-42198 and CVE-2026-54291, fixed in 42.7.12. -->
    <postgresql.version>42.7.12</postgresql.version>
    <!--
      "Spring Data" per SRS 6.2 means this module's data-access layer, not the Spring Boot
      application framework — that is tributary-api's tech explicitly (its own row in the same
      table). spring-jdbc alone gives JdbcTemplate without pulling in Spring Boot autoconfiguration,
      which fits a schema where PostgreSQL triggers are the authority (ADR-002): explicit SQL, no
      ORM mapping between the trigger-verified rows and a Java entity graph.
    -->
    <!-- T-704/SCA (trivy): 6.2.8 carries CVE-2025-41249, fixed in 6.2.11. -->
    <spring-jdbc.version>6.2.19</spring-jdbc.version>
    <hikaricp.version>6.3.0</hikaricp.version>
    <flyway.version>11.8.2</flyway.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <slf4j.version>2.0.17</slf4j.version>
    <!--
      T-704/SCA (trivy): this module pulls jackson-databind transitively at a stale 2.15.2
      (nothing here imports the Spring Boot BOM that tributary-api uses — see L-023) — carries
      GHSA-r7wm-3cxj-wff9, CVE-2026-54512, CVE-2026-54513, all fixed by 2.18.8+. Pinned explicitly
      at distance 1, same reasoning as the slf4j pin below.
    -->
    <jackson.version>2.21.4</jackson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.tributary</groupId>
      <artifactId>tributary-application</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <version>${spring-jdbc.version}</version>
    </dependency>
    <!--
      Pinned explicitly (SRS 5.3: no unpinned transitive versions) at distance 1 so Maven's
      nearest-wins mediation picks THIS 2.0.17, not HikariCP's transitive 1.7.36 — the old
      slf4j-api uses a different binding mechanism (StaticLoggerBinder) than the 2.x SPI-based
      slf4j-simple below expects, so the wrong version silently swallows every log line, including
      Testcontainers' own diagnostics for why a Docker strategy failed. Found by exactly that
      failure mode while debugging T-208.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikaricp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <!--
      Pinned explicitly at distance 1 (same reasoning as the slf4j pin above) so Maven's
      nearest-wins mediation picks this version instead of flyway-core's own transitive
      jackson-databind:2.15.2 — see the jackson.version comment in <properties> for the CVEs.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Without an SLF4J binding, Testcontainers' own diagnostics (why a Docker strategy failed
         to connect, container startup logs) are silently swallowed by the no-op logger — exactly
         the wrong time to have no evidence. Test scope only. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Toolchain Q / SRS 9: mutates the Java-side logic that computes/verifies chain
        integrity (ChainVerifier, PiiCipher, the repositories) — the actual immutability and
        chaining GUARANTEE lives in the PL/pgSQL triggers (ADR-002), which are not JVM
        bytecode and can't be mutated by PIT; those are verified separately, against real
        PostgreSQL via Testcontainers (CV-02/CV-03), not by this tool.
      -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.tributary.persistence.*</param>
          </targetClasses>
          <targetTests>
            <param>com.tributary.persistence.*</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
