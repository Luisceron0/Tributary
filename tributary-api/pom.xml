<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tributary</groupId>
    <artifactId>tributary</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tributary-api</artifactId>
  <name>Tributary :: API</name>
  <description>REST API, OAuth2, RBAC, response headers and OpenAPI.</description>

  <properties>
    <!--
      tributary-api is the only module SRS 6.2 has depending on every adapter AND persistence —
      exactly why ArchitectureTest lives here (agreement A-2). It's also, for the same reason, the
      only place a test can prove something that spans an adapter and persistence together (e.g.
      T-402: "after cancelling, the verifier still returns INTACT" needs the ES adapter's hasher
      AND persistence's real chain storage/verifier in the same test). postgresql/spring-jdbc/
      HikariCP arrive transitively from tributary-persistence's compile-scope dependencies;
      Testcontainers does not (test-scope dependencies aren't transitive), so it's redeclared here.

      Spring Boot 3.5.3 (T-700+, phase 7): SRS 6.2 names this module's technology explicitly
      ("Spring Boot 3, REST, OAuth2, RBAC, cabeceras, OpenAPI") — deliberately not pulled in
      before now, matching every other phase's own "no infrastructure ahead of the task that
      needs it" discipline. Imported as a dependencyManagement BOM (pinned to one exact version,
      not a range — SRS 5.3) rather than switching this module's Maven parent, so the rest of the
      reactor's own pinned-version discipline (this project's own parent pom) is untouched.
    -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <slf4j.version>2.0.17</slf4j.version>
    <spring-boot.version>3.5.16</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        spring-boot-dependencies manages its own (older, 1.21.2) Testcontainers version, which
        silently wins over this module's own direct 1.21.4 dependencies on some transitive edges
        (org.testcontainers:jdbc/testcontainers) unless pinned explicitly here — the exact same
        conflict shape lesson L-016 already found once this session (testcontainers/Docker-daemon
        API incompatibility), here reintroduced by the BOM import. Explicit entries after the BOM
        import always win over what it manages, regardless of import order.
      -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>jdbc</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>database-commons</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.tributary</groupId>
      <artifactId>tributary-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tributary</groupId>
      <artifactId>tributary-adapter-co-factus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tributary</groupId>
      <artifactId>tributary-adapter-es-verifactu</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tributary</groupId>
      <artifactId>tributary-adapter-de-en16931</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tributary</groupId>
      <artifactId>tributary-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- REST, validation, RBAC route protection, JWT resource-server verification (T-604/606). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Real bug found building T-604/605 (RC-1's own end-to-end integration test): without
        -parameters, @PathVariable String businessKey (no explicit name string) fails at request
        time with "parameter name information not available via reflection" — not a compile
        error, so it went undetected until an actual HTTP call hit a route with an unnamed
        @PathVariable. Scoped to this module only: it is the one place in the reactor doing any
        reflection-based parameter-name binding at all (Spring MVC route params) — no other
        module needs it.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <!-- Produces the executable jar T-705's docker-compose runs — not activated until phase 7
           needed a real deployable artifact; no earlier phase packaged anything beyond a test jar. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
