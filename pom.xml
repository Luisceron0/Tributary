<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.tributary</groupId>
  <artifactId>tributary</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Tributary</name>
  <description>Multi-regime fiscal issuance service (reference implementation)</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!--
    Module order follows the dependency direction of SRS 6.2: domain depends on
    nothing, application depends on domain, adapters depend inward on
    application and never on each other, api depends on all of them.
  -->
  <modules>
    <module>tributary-domain</module>
    <module>tributary-application</module>
    <module>tributary-adapter-co-factus</module>
    <module>tributary-adapter-es-verifactu</module>
    <module>tributary-adapter-de-en16931</module>
    <module>tributary-persistence</module>
    <module>tributary-api</module>
  </modules>

  <properties>
    <!--
      SRS 8 pins Java 21 LTS. The toolchain may be newer; the release level is
      what the SRS specifies, so it is fixed here rather than inherited from
      whatever JDK happens to be installed.
    -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      SRS 5.3: versions are pinned, never ranges. 5.12.2 -> 5.14.4: cucumber-junit-platform-engine
      needs junit-platform-engine >= 1.13 (org.junit.platform.engine.support.discovery.
      DiscoveryIssueReporter, added in that release) — without this bump, PIT's minion (which
      discovers every JUnit Platform TestEngine on the classpath, including Cucumber's) crashes
      with NoClassDefFoundError before mutation testing ever starts. Found running PIT for real,
      not assumed.
    -->
    <junit.version>5.14.4</junit.version>
    <jqwik.version>1.9.3</jqwik.version>
    <archunit.version>1.4.1</archunit.version>

    <!--
      Toolchain O/Q: line coverage (JaCoCo) is the secondary metric — 85% of lines executed
      without a real assertion is 0% protection. Mutation score (PIT) is the anchor metric for
      tributary-domain and tributary-persistence (SRS 9): a surviving mutant in the fiscal
      arithmetic or the state machine is a test that doesn't exist, not a detail to wave off.
      cucumber-jvm is available repo-wide for Gherkin acceptance scenarios (test scope only,
      same reasoning ADR-001 already applies to junit/jqwik above).
    -->
    <jacoco.version>0.8.15</jacoco.version>
    <pitest.version>1.25.9</pitest.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    <cucumber.version>7.34.6</cucumber.version>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Test-only dependencies are declared here, in the parent, so that every
    module inherits them and tributary-domain/pom.xml can carry no <dependencies>
    block at all.

    ADR-001 constrains what ships in the domain artefact: no Spring, no Jackson,
    no JDBC, nothing at compile or runtime scope. It does not — and cannot —
    forbid a test harness, since SRS 9 requires jqwik property-based tests and
    90% coverage inside that very module. Keeping these here satisfies both the
    architectural rule and T-003's literal verification criterion.

    ArchUnit (CV-07) enforces the real constraint at the import level, and it
    is not weakened by anything in this block.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>${jqwik.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Version managed by junit-bom above, matching junit-platform-engine's own version. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!--
              This is a multi-module reactor: a `-Dtest=SomeClass` filter (e.g. the
              documented `mvn test -Dtest=ArchitectureTest`, CV-07) only matches inside
              the one module that declares that class. Without this, surefire's default
              fails the BUILD in every other module for finding "0 matching tests" —
              which is not a real failure, just the filter not applying there. This does
              NOT ignore actual test failures; testFailureIgnore stays false (the
              default) everywhere.
            -->
            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
            <!--
              Toolchain Q: cucumber-junit-platform-engine is inherited repo-wide for Gherkin
              support, but most modules have no feature files. Without this, the engine runs as
              a bare "root engine" during discovery and fails hard instead of finding 0
              scenarios, breaking `mvn test` everywhere it isn't used. Set directly through
              Surefire's own configurationParameters (not only the classpath
              junit-platform.properties file each module also carries) because the properties
              file alone was not reliably picked up on every discovery pass observed in
              tributary-api. Confines Cucumber to running only via an explicit @Suite class with
              @IncludeEngines("cucumber") — see tributary-domain's RunCucumberTest.
            -->
            <properties>
              <configurationParameters>
                cucumber.junit-platform.discovery.as-root-engine=false
              </configurationParameters>
            </properties>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <!--
            Not bound to the default build in every module — only tributary-domain and
            tributary-persistence activate it (their own pom.xml), each with its own
            targetClasses, since PIT needs to know what to mutate per module and mutating
            everything reactor-wide would be slow with no extra signal (adapters/API are
            covered by integration tests against real Testcontainers/Factus sandbox
            behavior, not unit-level mutation).
          -->
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5-plugin.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <!-- SRS 9 / Q toolchain: the anchor metric, not line coverage. -->
            <mutationThreshold>60</mutationThreshold>
            <timestampedReports>false</timestampedReports>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
